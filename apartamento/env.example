NODE_ENV=development
PORT=8080
LOCAL_APP_PORT=8095
HOST=0.0.0.0

DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5433/natarundi
SESSION_SECRET=change-me-in-production

APP_SEED_DEMO=1
APP_DEMO_EMAIL=demo@natarundi.local
APP_DEMO_PASSWORD=set-a-local-demo-secret

AI_OFFLINE_STUB=1
AI_ROUTING_MODE=BALANCED
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ECONOMY=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_BALANCED=google/gemini-2.5-flash
# Optional override for analyzing project reference images
OPENROUTER_MODEL_VISION=
# Optional override for the quote search agent
OPENROUTER_MODEL_PRICING=
OPENROUTER_MODEL_FRONTIER=anthropic/claude-sonnet-4

# Tipo de cambio USD/CRC (venta BCCR por defecto)
FX_PROVIDER=bccr-proxy
FX_USE_FIELD=venta
FX_CACHE_TTL_MINUTES=360
BCCR_API_TOKEN=
DEFAULT_USD_CRC_RATE=520
