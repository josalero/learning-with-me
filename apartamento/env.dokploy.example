# Dokploy — variables para docker-compose.dokploy.yml
# Copia estos valores en el panel de Environment de Dokploy (no commits con secretos reales).

# --- Postgres (servicio db) ---
POSTGRES_USER=natarundi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=natarundi

# --- App (servicio app) ---
# Imagen publicada por .github/workflows/apartamento-dokploy.yml
APP_IMAGE=ghcr.io/josalero/learning-with-me/apartamento:feat-apartamento-dokploy-ci

# Debe coincidir con POSTGRES_* y usar el hostname del servicio: db
DATABASE_URL=postgresql://natarundi:change-me-strong-password@db:5432/natarundi

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Sesión (genera uno largo: openssl rand -hex 32)
SESSION_SECRET=change-me-session-secret

# Demo: en producción normalmente 0. Si 1, requiere APP_DEMO_PASSWORD al arrancar (entrypoint seed).
APP_SEED_DEMO=0
APP_DEMO_EMAIL=
APP_DEMO_PASSWORD=

# OpenRouter (agentes). Sin clave, usa AI_OFFLINE_STUB=1 en staging.
AI_OFFLINE_STUB=0
AI_ROUTING_MODE=BALANCED
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ECONOMY=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_BALANCED=google/gemini-2.5-flash
OPENROUTER_MODEL_FRONTIER=anthropic/claude-sonnet-4

# Tipo de cambio USD/CRC
# Recomendado (sin token): FX_PROVIDER=bccr-proxy → JSON público con compra/venta BCCR
# Alternativas sin token: exchangerate-api (no es dato BCCR) | static (solo DEFAULT_USD_CRC_RATE)
# Con token BCCR oficial: FX_PROVIDER=bccr-sdde + BCCR_API_TOKEN (Indicadores Económicos BCCR)
FX_PROVIDER=bccr-proxy
FX_USE_FIELD=venta
FX_CACHE_TTL_MINUTES=360
BCCR_API_TOKEN=
DEFAULT_USD_CRC_RATE=520

# Dokploy suele publicar el servicio app en el puerto 8080 del compose y poner TLS delante.
# No hace falta LOCAL_APP_PORT ni PG_HOST_PORT (la DB no se expone al host).
