# Copy to software-dev-team-cursor/.env
# Create a Cursor API key at https://cursor.com/dashboard?tab=integrations
# The `agent` CLI must be on PATH (`agent --version`). `agent login` is not enough
# for this lab — set CURSOR_API_KEY so headless `-p` runs are non-interactive.
CURSOR_API_KEY=
# Leave as `agent`. An absolute host path breaks `docker compose` (the image ships
# its own Linux CLI at /usr/local/bin/agent).
SDLC_CURSOR_CLI=agent
CURSOR_MAX_TOKENS=8192
# Per Cursor CLI call (ISO-8601). Raise to PT5M if a role times out.
SDLC_LLM_TIMEOUT=PT3M

# Cheap/fast model for PO, QA, Stakeholder (`agent --list-models`)
MODEL_FAST=composer-2.5

# Strong coding model for Tech Lead, Developer, PR Reviewer
MODEL_STRONG=composer-2.5

SDLC_HOME=.
SDLC_PORT=8096

# true = canned ChatModel, no Cursor key required (pipeline walkthrough only)
SDLC_OFFLINE=false

# docker compose up reads this file. SDLC_HOME is overridden to /data in compose.
#
# Live runs work in both places:
#   host:   export SDLC_CURSOR_CLI=agent && ./gradlew :sdlc-app:bootRun   (uses your PATH `agent`)
#   docker: docker compose up --build                                     (uses the CLI baked into the image)
# Build an offline-only image with no cursor.com download: INSTALL_CURSOR_CLI=false
