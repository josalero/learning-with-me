# Copy to software-dev-team/.env
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=8192
# Per OpenRouter HTTP call (ISO-8601). LangChain4j's default is 60s and times out
# on slow completions / tool loops. Example: PT5M for a slower MODEL_STRONG.
SDLC_LLM_TIMEOUT=PT3M

# Cheap/fast model for PO, QA, Stakeholder
MODEL_FAST=openai/gpt-4o-mini

# Strong coding model for Tech Lead, Developer, PR Reviewer
MODEL_STRONG=openai/gpt-4o-mini

SDLC_HOME=.
SDLC_PORT=8095

# true = canned ChatModel, no OpenRouter key required (pipeline walkthrough only)
SDLC_OFFLINE=false

# docker compose up reads this file. SDLC_HOME is overridden to /data in compose.
