# Copy to .env and export before docker compose or bootRun.
# These values are local-only. Do not commit a filled .env file.

POSTGRES_PASSWORD=change-me
POSTGRES_USER=stateful
POSTGRES_DB=stateful_agent
POSTGRES_PORT=5433

AGENT_ALICE_PASSWORD=change-me-alice
AGENT_BOB_PASSWORD=change-me-bob
AGENT_CAROL_PASSWORD=change-me-carol
AGENT_DAVE_PASSWORD=change-me-dave

# OpenRouter. Leave the profile empty until OPENROUTER_API_KEY is set.
# Suggested model: openai/gpt-4o-mini (tool calling, short and cheap for this funnel).
SPRING_PROFILES_ACTIVE=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Base collector URL. Boot appends /v1/traces and /v1/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
