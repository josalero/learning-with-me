{
  "info": {
    "name": "Stateful hiring agent",
    "description": "One ordered run for a fresh database.\n\n1. docker compose down -v && docker compose up --build\n2. .env has SPRING_PROFILES_ACTIVE=openrouter, OPENROUTER_API_KEY, and OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini\n3. Import this file and Local.postman_environment.json\n4. Select the Local environment\n5. Set the four password collection variables to the AGENT_*_PASSWORD values in .env\n6. Collection Runner: open this collection and run it from top to bottom. Do not reorder the requests.\n\nAPP-1 ends HIRED. Run it once per fresh volume.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "alice",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{alicePassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "applicationId",
      "value": "APP-1"
    },
    {
      "key": "provider",
      "value": "OPENROUTER"
    },
    {
      "key": "alicePassword",
      "value": "change-me-alice",
      "description": "AGENT_ALICE_PASSWORD"
    },
    {
      "key": "bobPassword",
      "value": "change-me-bob",
      "description": "AGENT_BOB_PASSWORD"
    },
    {
      "key": "carolPassword",
      "value": "change-me-carol",
      "description": "AGENT_CAROL_PASSWORD"
    },
    {
      "key": "davePassword",
      "value": "change-me-dave",
      "description": "AGENT_DAVE_PASSWORD"
    },
    {
      "key": "aliceSessionId",
      "value": ""
    },
    {
      "key": "bobSessionId",
      "value": ""
    },
    {
      "key": "approvalId",
      "value": ""
    },
    {
      "key": "toolCallKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('up', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create Alice session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"{{provider}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Alice session', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(body.provider).to.eql('OPENROUTER');",
              "});",
              "pm.collectionVariables.set('aliceSessionId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read APP-1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{aliceSessionId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"What is the current stage of application APP-1? Call getApplication and include the stage name in your answer.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('read completes', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.status).to.eql('COMPLETED');",
              "    pm.expect(body.approval == null).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Confirm recruiter screen",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('stage is RECRUITER_SCREEN', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().stage).to.eql('RECRUITER_SCREEN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Schedule tech screen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{aliceSessionId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Move application APP-1 to stage TECH_SCREEN. Call advanceApplication. Do not invent a stage.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('paused for advanceApplication', function () {",
              "    pm.response.to.have.status(202);",
              "    pm.expect(body.status).to.eql('AWAITING_APPROVAL');",
              "    pm.expect(body.approval.risk).to.eql('MEDIUM');",
              "    pm.expect(body.approval.calls[0].toolName).to.eql('advanceApplication');",
              "});",
              "pm.collectionVariables.set('approvalId', body.approval.id);",
              "pm.collectionVariables.set('toolCallKey', body.approval.calls[0].toolCallKey);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Deny schedule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
