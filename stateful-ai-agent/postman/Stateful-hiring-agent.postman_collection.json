        "url": "{{baseUrl}}/api/v1/sessions/{{aliceSessionId}}/approvals/{{approvalId}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decisions\": [\n    {\n      \"toolCallKey\": \"{{toolCallKey}}\",\n      \"decision\": \"DENY\",\n      \"reason\": \"Not now\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
