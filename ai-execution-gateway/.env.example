# Copy to .env and run ./scripts/up.sh. These values are local demo credentials, not secrets.
POSTGRES_PASSWORD=change-me
# Signs audit hashes. It does not log anyone in.
GATEWAY_AUDIT_HMAC_KEY=change-me-hmac-key
# recruiter-alice (acme). Scenarios 1 and 2, and the approval.
DEMO_RECRUITER_API_KEY=gw_alice_local_demo_key_not_a_secret_000000000
# ats-nightly (acme). Scenario 3. Cannot approve.
DEMO_ATS_API_KEY=gw_ats_local_demo_key_not_a_secret_00000000000
# recruiter-bob (globex). Used only to show a foreign tenant gets 404.
DEMO_GLOBEX_API_KEY=gw_bob_local_demo_key_not_a_secret_00000000000
# stub = scripted model, no network, same numbers every run. live = OpenRouter (fill the two values below).
GATEWAY_PROFILE=stub
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
